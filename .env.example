DATABASE_URL=postgres://concierge:concierge@localhost:5433/concierge
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Anthropic (required unless FAKE_MODEL=true)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
FAKE_MODEL=true

# Voyage AI embeddings (required unless FAKE_EMBEDDINGS=true)
VOYAGE_API_KEY=
FAKE_EMBEDDINGS=true

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (password reset)
RESEND_API_KEY=
EMAIL_FROM=

# Comma-separated emails with platform-owner access
PLATFORM_OWNER_EMAILS=

# Dev only: let the crawler fetch private/loopback hosts (disables the SSRF guard). Keep false in production.
CRAWL_ALLOW_PRIVATE_HOSTS=false
