[Unit]
Description=Concierge - Next.js web app (admin, auth, widget API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/concierge
Environment=NODE_ENV=production
# 3000 is taken by Milian Jo on this host.
Environment=PORT=3100
# HOSTNAME is not read by `next start`; the bind address is the -H flag below.
# Owned root:ubuntu, mode 640 (deploy/README.md step 1). systemd reads it as root before dropping to User=.
# npm/node must not write under /home (ProtectHome=read-only).
Environment=HOME=/srv/concierge
Environment=npm_config_cache=/tmp/npm-cache
EnvironmentFile=/etc/concierge.env
# `next start` ignores HOSTNAME (it defaults to 0.0.0.0); -H keeps it on loopback so only nginx reaches it.
ExecStart=/srv/concierge/node_modules/.bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The app dir (npm/next caches) and, for STORAGE_DRIVER=local, STORAGE_LOCAL_DIR=/srv/concierge-data/storage.
ReadWritePaths=/srv/concierge /srv/concierge-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
