[Unit]
Description=Concierge - Next.js web app (admin, auth, widget API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own unprivileged user: the code under /srv/concierge is owned by ubuntu and only readable by this
# user, so a bug in the app can't change the code a later deploy runs, read other users' files, or use sudo.
User=concierge
Group=concierge
WorkingDirectory=/srv/concierge
Environment=NODE_ENV=production
# 3000 is taken by Milian Jo on this host.
Environment=PORT=3100
Environment=HOME=/tmp
Environment=npm_config_cache=/tmp/npm-cache
# Owned root:concierge, mode 640. systemd reads it as root before dropping to User=.
EnvironmentFile=/etc/concierge.env
# `next start` ignores HOSTNAME (it defaults to 0.0.0.0); -H keeps it on loopback so only nginx reaches it.
ExecStart=/srv/concierge/node_modules/.bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=3
MemoryMax=600M
# Writable: Next's runtime caches (.next/cache, and the page cache Next 16 writes to .next/server/route-cache),
# and uploads (STORAGE_DRIVER=local, STORAGE_LOCAL_DIR=/srv/concierge-data/storage).
ReadWritePaths=/srv/concierge/.next/cache /srv/concierge/.next/server/route-cache /srv/concierge-data

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
# If memory runs out on this shared host, the kernel kills Concierge before Milian Jo.
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
