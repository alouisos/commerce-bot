[Unit]
Description=Concierge - pg-boss worker (crawl, ingest, schedules)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/concierge
Environment=NODE_ENV=production
# Owned root:ubuntu, mode 640 (deploy/README.md step 1). systemd reads it as root before dropping to User=.
# npm/node must not write under /home (ProtectHome=read-only).
Environment=HOME=/srv/concierge
Environment=npm_config_cache=/tmp/npm-cache
EnvironmentFile=/etc/concierge.env
ExecStart=/srv/concierge/node_modules/.bin/tsx src/worker/index.ts
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The app dir (npm/next caches) and, for STORAGE_DRIVER=local, STORAGE_LOCAL_DIR=/srv/concierge-data/storage.
ReadWritePaths=/srv/concierge /srv/concierge-data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
