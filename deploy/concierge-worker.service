[Unit]
Description=Concierge - pg-boss worker (crawl, ingest, schedules)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# See concierge-web.service: its own unprivileged user, code read-only.
User=concierge
Group=concierge
WorkingDirectory=/srv/concierge
Environment=NODE_ENV=production
Environment=HOME=/tmp
Environment=npm_config_cache=/tmp/npm-cache
EnvironmentFile=/etc/concierge.env
ExecStart=/srv/concierge/node_modules/.bin/tsx src/worker/index.ts
Restart=always
RestartSec=3
# Upload parsing runs in a worker thread capped at a 512 MB heap (src/lib/kb/extract.ts).
MemoryMax=900M
# Writable: uploads (STORAGE_DRIVER=local).
ReadWritePaths=/srv/concierge-data

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
# If memory runs out on this shared host, the kernel kills Concierge before Milian Jo.
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
